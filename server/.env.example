DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=4000
FRONTEND_URL="http://localhost:5173"

# Payment gateway: tap | myfatoorah | mock
# "mock" needs no credentials and always succeeds instantly — useful for
# local development when no gateway keys are configured yet.
PAYMENT_PROVIDER="tap"

# Tap Payments (https://dashboard.tap.company) — sign up, then copy your
# Test Secret Key (starts with sk_test_) from the dashboard.
TAP_SECRET_KEY=""
TAP_BASE_URL="https://api.tap.company/v2"

# MyFatoorah (https://portal.myfatoorah.com) — register a free demo account
# at https://registertest.myfatoorah.com/en/ to get a Bearer test token.
MYFATOORAH_API_KEY=""
MYFATOORAH_BASE_URL="https://apitest.myfatoorah.com"
